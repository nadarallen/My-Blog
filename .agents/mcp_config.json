{
  "mcpServers": {
    "aws-mcp": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@1.6.4",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--profile",
        "default",
        "--region",
        "ap-south-1",
        "--metadata",
        "AWS_REGION=ap-south-1"
      ]
    }
  }
}
