# ==============================================================================
# My-Blog Git Ignore Configuration
# ==============================================================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.manifest
*.spec

# --- Virtual Environments ---
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# --- Environment Variables & Secrets (CRITICAL: Never commit credentials) ---
.env
.env.local
.env.*.local
.env.production
*.pem
*.key
*.cert
*.crt
secrets.json
credentials.json
# Allow committed template/example files:
!*.env.example
!.env.production.example

# --- Testing, Coverage & QA ---
.pytest_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.mutmut-cache/

# --- Logs & Runtime Artifacts ---
logs/
*.log
*.sqlite
*.sqlite3
*.db

# --- User Uploads (Managed by S3 in production / persistent volume) ---
static/uploads/*
!static/uploads/.gitkeep

# --- Operating System & Editor Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- IDEs & Text Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# --- Infrastructure & Terraform ---
.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info

# --- Executables & Binaries ---
*.exe
*.bin
*.dll

# --- Local Agent, Notes & Scratchpads ---
Agent.MD
agent.md
*.bak
scratch/
