# ─────────────────────────────────────────────────────────────
# My-Blog — Production Environment Variables
# Copy this file to .env.production and fill in your values.
#
#   cp .env.production.example .env.production
#
# NEVER commit .env.production to Git.
# ─────────────────────────────────────────────────────────────

# Flask secret key — used to sign sessions/cookies & CSRF tokens
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_64_CHAR_HEX_STRING

# Admin username — users with this username can edit/delete any post
ADMIN_USERNAME=admin

# Flask environment & debug mode — debug must be false in production
FLASK_ENV=production
FLASK_DEBUG=false

# ── AWS Settings (Uses EC2 IAM Instance Role — NO access keys needed here!)
AWS_REGION=ap-south-1
S3_BUCKET=your-unique-s3-bucket-name
DYNAMODB_POSTS_TABLE=myblog-posts
DYNAMODB_USERS_TABLE=myblog-users
