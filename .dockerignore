# Git
.git
.gitignore

# Environment files — NEVER bake secrets into the image
.env
.env.*
!.env.production.example

# Python cache
__pycache__
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
.venv/

# User-uploaded files (not part of the image)
static/uploads/

# Dev / editor artifacts
.vscode/
.idea/
*.swp
*.swo
*.DS_Store

# Test & Infra artifacts (not needed in container runtime)
tests/
infra/
graphify-out/
logs/
.pytest_cache/
deploy/

